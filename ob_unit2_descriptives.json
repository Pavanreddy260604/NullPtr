    "descriptives": [
        {
            "question": "1.c Explain personality types and factors influencing personality",
            "topic": "Organizational Behaviour",
            "answer": [
                {
                    "type": "heading",
                    "content": "Personality Types and Factors Influencing Personality"
                },
                {
                    "type": "subheading",
                    "content": "Introduction"
                },
                {
                    "type": "text",
                    "content": "Personality refers to the relatively stable set of characteristics that influence an individual’s behaviour and lend it consistency. It represents the dynamic organization of psycho-physical systems that determine how a person adjusts to the environment."
                },
                {
                    "type": "heading",
                    "content": "I. Personality Types (Five Personality Traits)"
                },
                {
                    "type": "subheading",
                    "content": "1. Neuroticism"
                },
                {
                    "type": "text",
                    "content": "Tendency to experience negative emotions (anxiety, anger). High = unstable; Low = calm/stable."
                },
                {
                    "type": "subheading",
                    "content": "2. Extraversion"
                },
                {
                    "type": "text",
                    "content": "Characterized by sociability and assertiveness. Extroverts are outgoing; introverts are reserved."
                },
                {
                    "type": "subheading",
                    "content": "3. Openness to Experience"
                },
                {
                    "type": "text",
                    "content": "Reflects imagination, creativity, and curiosity toward new ideas."
                },
                {
                    "type": "subheading",
                    "content": "4. Agreeableness"
                },
                {
                    "type": "text",
                    "content": "Being cooperative and compassionate. Highly agreeable people are altruistic."
                },
                {
                    "type": "subheading",
                    "content": "5. Conscientiousness"
                },
                {
                    "type": "text",
                    "content": "Indicates self-discipline and achievement orientation. Organized and goal-focused."
                },
                {
                    "type": "code",
                    "content": "          PERSONALITY TYPES\n                  |\n -------------------------------------------------\n |        |           |           |              |\nNeurotic Extraversion Openness  Agreeableness Conscientiousness"
                },
                {
                    "type": "heading",
                    "content": "II. Factors Influencing Personality"
                },
                {
                    "type": "subheading",
                    "content": "1. Heredity"
                },
                {
                    "type": "text",
                    "content": "Genetic traits inherited from parents (physical, temperament)."
                },
                {
                    "type": "subheading",
                    "content": "2. Environment"
                },
                {
                    "type": "text",
                    "content": "Family, social groups, culture, and education (e.g., Indian culture values)."
                },
                {
                    "type": "subheading",
                    "content": "3. Situation"
                },
                {
                    "type": "text",
                    "content": "Behaviour varies. For example, behaving differently in a park vs. an office interview."
                },
                {
                    "type": "code",
                    "content": "          PERSONALITY\n               |\n      -------------------------\n      |           |           |\n   Heredity   Environment   Situation"
                }
            ]
        },
        {
            "question": "2.c Explain the learning process and learning theories",
            "topic": "Organizational Behaviour",
            "answer": [
                {
                    "type": "heading",
                    "content": "Learning Process and Theories"
                },
                {
                    "type": "text",
                    "content": "Learning is a relatively permanent change in behaviour resulting from experience."
                },
                {
                    "type": "subheading",
                    "content": "I. Learning Process"
                },
                {
                    "type": "list",
                    "items": [
                        "Motive: Internal drive.",
                        "Stimuli: External triggers.",
                        "Response: Reaction.",
                        "Reinforcement: Strengthening behavior.",
                        "Retention: Remembering for future use."
                    ]
                },
                {
                    "type": "code",
                    "content": "Motive → Stimuli → Response → Reinforcement → Retention"
                },
                {
                    "type": "subheading",
                    "content": "II. Learning Theories"
                },
                {
                    "type": "text",
                    "content": "1. Classical Conditioning (Pavlov): Learning via association (Bell + Food = Salivation)."
                },
                {
                    "type": "text",
                    "content": "2. Cognitive Learning (Tolman): Focuses on mental maps, thinking, and memory processes."
                }
            ]
        },
