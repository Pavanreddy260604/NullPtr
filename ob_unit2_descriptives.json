            "topic": "Organizational Behaviour",
            "answer": [
                {
                    "type": "heading",
                    "content": "Emotional Intelligence (EI)"
                },
                {
                    "type": "text",
                    "content": "EI refers to the ability to understand and manage emotions in oneself and others."
                },
                {
                    "type": "subheading",
                    "content": "Components (Theory) of EI"
                },
                {
                    "type": "list",
                    "items": [
                        "Self-Awareness: Recognizing own moods.",
                        "Self-Regulation: Controlling impulses.",
                        "Motivation: Directing emotions toward goals.",
                        "Empathy: Understanding others' feelings.",
                        "Social Skills: Managing relationships."
                    ]
                },
                {
                    "type": "code",
                    "content": "           EMOTIONAL INTELLIGENCE\n                      |\n ------------------------------------------------\n |            |           |          |           |\nSelf-Awareness Self-Reg   Motivation Empathy  Social Skills"
                }
            ]
