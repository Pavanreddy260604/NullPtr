{
    "rewrites": [
        {
            "source": "/api/auth/:match*",
            "destination": "/api/auth.js"
        },
        {
            "source": "/api/:match*",
            "destination": "/api/index.js"
        },
        {
            "source": "/:match*",
            "destination": "/index.html"
        }
    ]
}